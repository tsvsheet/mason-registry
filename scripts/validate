#!/bin/bash
# Validate every mason package definition, then prove it against reality:
# the pin must be the upstream's latest release, every templated asset filename
# must exist on that release, and every archive asset must contain the binary
# its definition names — so a definition that drifts from the real artifacts,
# or goes stale, can never publish. Requires yq, gh (authenticated), curl, tar.
#
# Usage:
#   scripts/validate [packages-directory]
# Where:
#   packages-directory holds <name>/package.yaml definitions. Default: <repo>/packages
#
set -o errexit
set -o nounset
set -o pipefail

exec 3>&1 4>&2

PACKAGES_DIR=${1:-}
[[ ${PACKAGES_DIR} ]] || PACKAGES_DIR="$(git rev-parse --show-toplevel)/packages"

WORK_DIR=$(mktemp -d)
trap 'rm -rf "${WORK_DIR}"' EXIT

# The only template token the definitions use; anything else must fail loudly
# so a new token forces this validator to learn it before it can publish.
VERSION_TOKEN='{{ version | strip_prefix "v" }}'

# mason-core/platform.lua target identifiers this registry is allowed to use.
KNOWN_TARGETS='darwin_arm64 darwin_x64 linux_arm64 linux_arm linux_x64 linux_x86 win_arm64 win_x64 win_x86'

# True only when the yq expression evaluates successfully AND truthy, so a
# missing field (yq error) and a false predicate both fail identically.
yaml-holds() {
  yq -e "${2}" "${1}" > /dev/null 2>&1
}

validate-shape() {
  local yaml=$1 name=$2

  local check
  for check in \
    ".name == \"${name}\"" \
    '.description | (type == "!!str" and length > 0)' \
    '.homepage | (type == "!!str" and length > 0)' \
    '.licenses | (type == "!!seq" and length > 0)' \
    '.languages | (type == "!!seq" and length > 0)' \
    '.categories | (type == "!!seq" and length > 0)' \
    '.bin | (type == "!!map" and length > 0)' \
    '.source.asset | (type == "!!seq" and length > 0)' \
    '[.source.asset[] | select(.target == null or .file == null or .bin == null)] | length == 0'; do
    yaml-holds "${yaml}" "${check}" || {
      printf >&4 '✗ %s: failed: %s\n' "${name}" "${check}"
      return 1
    }
  done

  local target
  for target in $(yq -r '.source.asset[].target' "${yaml}"); do
    [[ " ${KNOWN_TARGETS} " = *" ${target} "* ]] || {
      printf >&4 '✗ %s: unknown target %s\n' "${name}" "${target}"
      return 1
    }
  done
}

# Resolve the version token in a template, refusing any token it does not know.
resolve() {
  local template=$1 version=$2
  local resolved=${template//"${VERSION_TOKEN}"/${version#v}}
  [[ ${resolved} != *'{{'* ]] || {
    printf >&4 '✗ unsupported template token in %s\n' "${template}"
    return 1
  }
  printf '%s' "${resolved}"
}

# For an archive asset, the declared binary must exist inside the real artifact.
verify-member() {
  local repo=$1 version=$2 file=$3 member=$4
  [[ ${file} = *.tar.gz ]] || {
    printf >&4 '✗ %s: validator does not know how to open %s — teach it first\n' "${repo}" "${file}"
    return 1
  }
  [[ -e "${WORK_DIR}/${file}" ]] \
    || gh release download "${version}" --repo "${repo}" --pattern "${file}" --output "${WORK_DIR}/${file}" || {
    printf >&4 '✗ %s: could not download %s from %s\n' "${repo}" "${file}" "${version}"
    return 1
  }
  tar -tzf "${WORK_DIR}/${file}" | grep -qxF -- "${member}" || {
    printf >&4 '✗ %s: %s does not contain %s\n' "${repo}" "${file}" "${member}"
    return 1
  }
}

validate-assets() {
  local yaml=$1 name=$2

  local id
  id=$(yq -r '.source.id' "${yaml}")
  [[ ${id} =~ ^pkg:github/([^/@]+)/([^/@]+)@(v[0-9][^@]*)$ ]] || {
    printf >&4 '✗ %s: source.id %s is not pkg:github/<owner>/<repo>@v<semver>\n' "${name}" "${id}"
    return 1
  }
  local repo="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}" version="${BASH_REMATCH[3]}"

  # Currency IS this registry's contract: a pin behind the upstream's latest
  # release fails the gate, which is the signal to bump source.id.
  local latest
  latest=$(gh api "repos/${repo}/releases/latest" --jq '.tag_name') || {
    printf >&4 '✗ %s: could not resolve the latest release of %s\n' "${name}" "${repo}"
    return 1
  }
  [[ ${latest} = "${version}" ]] || {
    printf >&4 '✗ %s: pins %s but upstream latest is %s — bump source.id\n' "${name}" "${version}" "${latest}"
    return 1
  }

  local published
  published=$(gh api "repos/${repo}/releases/tags/${version}" --jq '.assets[].name') || {
    printf >&4 '✗ %s: release %s not found on %s (or the fetch failed)\n' "${name}" "${version}" "${repo}"
    return 1
  }

  local count=0 file member
  while IFS=$'\t' read -r file member; do
    file=$(resolve "${file}" "${version}") || return 1
    member=$(resolve "${member}" "${version}") || return 1
    grep -qxF -- "${file}" <<< "${published}" || {
      printf >&4 '✗ %s: asset %s does not exist on %s %s\n' "${name}" "${file}" "${repo}" "${version}"
      return 1
    }
    verify-member "${repo}" "${version}" "${file}" "${member}" || return 1
    ((count += 1))
  done < <(yq -r '.source.asset[] | .file + "	" + .bin' "${yaml}")

  printf >&3 '✓ %s: %s %s is upstream latest — %d assets exist, each carrying its declared binary\n' \
    "${name}" "${repo}" "${version}" "${count}"
}

shopt -s nullglob
PACKAGE_FILES=("${PACKAGES_DIR}"/*/package.yaml)
((${#PACKAGE_FILES[@]} > 0)) || {
  printf >&4 '✗ no package definitions found under %s\n' "${PACKAGES_DIR}"
  exit 1
}

failed=0
for yaml in "${PACKAGE_FILES[@]}"; do
  name=$(basename "$(dirname "${yaml}")")
  validate-shape "${yaml}" "${name}" && validate-assets "${yaml}" "${name}" || failed=1
done

exit "${failed}"
